# Copy to .env and fill in. Never commit .env.

# Local docker compose database (port 5433 to avoid clashing with a Homebrew postgres on 5432)
DATABASE_URL=postgres://steep:steep@localhost:5433/steep

# Public URL of the app; used in email links
APP_URL=http://localhost:3000
PORT=3000

# Resend (https://resend.com). Leave RESEND_API_KEY empty in dev to log emails to the console instead of sending.
RESEND_API_KEY=
FROM_EMAIL="Steep <onboarding@resend.dev>"

# Random 32+ char secrets: `openssl rand -hex 32`
JWT_SECRET=change-me-to-a-long-random-string
CRON_SECRET=change-me-to-another-long-random-string
