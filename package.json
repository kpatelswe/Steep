{
  "name": "steep",
  "private": true,
  "version": "0.1.0",
  "description": "Steep \u2014 your news, steeped overnight. A daily email of the 5 things worth knowing in each topic you follow.",
  "packageManager": "pnpm@10.26.2",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter server dev",
    "build": "pnpm -r build && rm -rf server/public && cp -r client/dist server/public",
    "test": "pnpm -r test",
    "lint": "eslint .",
    "typecheck": "pnpm -r typecheck",
    "db:generate": "pnpm --filter server db:generate",
    "db:migrate": "pnpm --filter server db:migrate",
    "db:seed": "pnpm --filter server db:seed",
    "start": "pnpm --filter server start",
    "feeds:refresh": "pnpm --filter server feeds:refresh",
    "email:preview": "pnpm --filter server email:preview"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.69.0"
  },
  "type": "module"
}
